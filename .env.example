# Django Settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (PostgreSQL + pgvector)
POSTGRES_DB=ai_saas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to True for testing without running a Redis instance on local Windows
CELERY_TASK_ALWAYS_EAGER=False

# JWT Authentication
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI Provider Settings (mock or gemini)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=mock-gpt-4o-mini
EMBEDDING_MODEL_NAME=mock-text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
SIMILARITY_THRESHOLD=0.55
MOCK_SIMILARITY_THRESHOLD=0.30
TOP_K_CHUNKS=4

# Storage & Upload Limits
MAX_UPLOAD_MB=10
STORAGE_BACKEND=local
STORAGE_DIR=storage/uploads
